from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.future import select
from uuid import UUID
from typing import List

from app.database import get_async_session
from app.models import RentalRequest, Item, User
from app.schemas import RentalRequestCreate, RentalRequest
from fastapi_users import FastAPIUsers
from app.users import auth_backend, fastapi_users
from app.models import User as UserModel

router = APIRouter(prefix="/rental-requests", tags=["Rental Requests"])

current_user = fastapi_users.current_user()

# Create a rental request
@router.post("/", response_model=RentalRequest)
async def create_rental_request(
    request_data: RentalRequestCreate,
    user: UserModel = Depends(current_user),
    session: AsyncSession = Depends(get_async_session),
):
    # Validate item exists
    result = await session.execute(select(Item).where(Item.id == request_data.item_id))
    item = result.scalar_one_or_none()
    if item is None:
        raise HTTPException(status_code=404, detail="Item not found")

    # Optional: Prevent requesting your own item
    if item.vendor_id == user.id:
        raise HTTPException(status_code=400, detail="You cannot request your own item")

    new_request = RentalRequest(
        item_id=request_data.item_id,
        requester_id=user.id,
        vendor_id=request_data.vendor_id,
        message=request_data.message,
        start_time=request_data.start_time,
        end_time=request_data.end_time,
        status="pending"
    )
    session.add(new_request)
    await session.commit()
    await session.refresh(new_request)
    return new_request


# Get all rental requests for the current user
@router.get("/", response_model=List[RentalRequest])
async def get_my_rental_requests(
    user: UserModel = Depends(current_user),
    session: AsyncSession = Depends(get_async_session),
):
    result = await session.execute(
        select(RentalRequest)
        .where((RentalRequest.requester_id == user.id) | (RentalRequest.vendor_id == user.id))
        .options()
    )
    return result.scalars().all()


# Accept or reject rental request (vendor only)
@router.patch("/{request_id}/status", response_model=RentalRequest)
async def update_request_status(
    request_id: int,
    status: str,
    user: UserModel = Depends(current_user),
    session: AsyncSession = Depends(get_async_session),
):
    result = await session.execute(select(RentalRequest).where(RentalRequest.id == request_id))
    rental_request = result.scalar_one_or_none()

    if rental_request is None:
        raise HTTPException(status_code=404, detail="Rental request not found")

    if rental_request.vendor_id != user.id:
        raise HTTPException(status_code=403, detail="Not authorized to update this request")

    if status not in ["accepted", "rejected"]:
        raise HTTPException(status_code=400, detail="Invalid status")

    rental_request.status = status
    await session.commit()
    await session.refresh(rental_request)
    return rental_request
